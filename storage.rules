rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{uid}/{caseId}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ub\\.edu\\.ph')
        && request.resource.size > 0 && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg)|application/pdf');
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && (request.auth.uid == uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'staff');
      allow update, delete: if false;
    }
  }
}
