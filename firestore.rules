rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // domainOk: any UB account (used for the profile doc, which is written before email verification).
    function domainOk() { return request.auth != null && request.auth.token.email.matches('.*@ub\\.edu\\.ph'); }
    // signedIn: UB account with a VERIFIED email. Required for everything involving complaints.
    function signedIn() { return domainOk() && request.auth.token.email_verified == true; }
    function userDoc() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    // Staff role can only be granted by an admin in the Firebase console (users docs are immutable from clients).
    function isStaff() { return signedIn() && userDoc().role == 'staff'; }
    function caseId(y, n) { return 'SAEP-' + y + '-' + (n < 10 ? '00' + string(n) : (n < 100 ? '0' + string(n) : string(n))); }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    // Today's date in Philippine time (UTC+8), computed from the SERVER clock, so a filer cannot backdate a complaint.
    function phToday() {
      let t = request.time + duration.time(8, 0, 0, 0);
      return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day());
    }
    // Order of the workflow. Moving a case to an earlier status needs a remark (see the history rule).
    function rank(s) { return s == 'submitted' ? 0 : (s == 'review' ? 1 : (s == 'hearing' ? 2 : 3)); }

    // The offense type and category must match an entry of the catalog (offenses/{offenseId}), so the
    // category always comes from the handbook list and cannot be edited in the browser.
    function offenseOk(d) {
      return d.offenseId is string && d.offenseId.matches('^[a-z0-9-]{2,60}$')
        && exists(/databases/$(db)/documents/offenses/$(d.offenseId))
        && get(/databases/$(db)/documents/offenses/$(d.offenseId)).data.type == d.type
        && get(/databases/$(db)/documents/offenses/$(d.offenseId)).data.category == d.offense
        // The offense must be one that can happen where the complainant says it happened (older catalog entries without venues allow both).
        && d.get('venue', 'campus') in get(/databases/$(db)/documents/offenses/$(d.offenseId)).data.get('venues', ['campus', 'offcampus']);
    }

    // Calendar date (YYYY-MM-DD) as a timestamp, for day arithmetic.
    function dateTs(s) { return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])); }
    function dateOrEmpty(s) { return s is string && (s == '' || isDate(s)); }
    // College Student Discipline Policy (SAEP M Rev. 4), Process: SAEP assessment and routing, notice (answer time of at least 3 days), conference, decision and appeal. Every field is optional
    // so older cases still validate; the app always sends them together.
    function processOk(n, old) {
      return (!('route' in n) || n.route == 'cdb' || n.route == old.get('route', n.route))
        && (!('noticeDate' in n) || dateOrEmpty(n.noticeDate))
        && (!('answerDue' in n) || dateOrEmpty(n.answerDue))
        && (!('answerDue' in n) || n.answerDue == '' || ('noticeDate' in n && n.noticeDate != ''))
        && (!('answerDue' in n && 'noticeDate' in n) || n.answerDue == '' || n.noticeDate == '' || dateTs(n.answerDue) >= dateTs(n.noticeDate) + duration.value(3, 'd'))
        && (!('answer' in n) || n.answer in ['', 'received', 'general-denial'])
        && (!('parentsNotified' in n) || dateOrEmpty(n.parentsNotified))
        && (!('conferenceMode' in n) || n.conferenceMode in ['', 'face-to-face', 'online'])
        && (!('conferencesHeld' in n) || (n.conferencesHeld is int && n.conferencesHeld >= 0 && n.conferencesHeld <= 20))
        && (!('decisionDate' in n) || dateOrEmpty(n.decisionDate))
        && (n.status != 'resolved' || ('decisionDate' in n && n.decisionDate != ''))
        && (!('interventions' in n) || (n.interventions is list && n.interventions.size() <= 7
            && n.interventions.hasOnly(['reprimand', 'censure', 'probation', 'community', 'suspension', 'exclusion', 'expulsion'])))
        && (!('appeal' in n) || n.appeal in ['', 'filed', 'upheld', 'modified', 'reversed'])
        && (!('appealDate' in n) || dateOrEmpty(n.appealDate))
        && (!('appeal' in n) || n.appeal == '' || (n.status == 'resolved' && 'appealDate' in n && n.appealDate != ''))
        // SAEP initially assesses the degree of the offense (policy, Process step 1). Second and Third Degree belong to the CDB.
        && (!('assessedDegree' in n) || n.assessedDegree in ['', 'First Degree', 'Second Degree', 'Third Degree'])
        && (!('assessedDegree' in n) || n.assessedDegree in ['', 'First Degree'] || n.route == 'cdb')
        && (!('deptDecisionDate' in n) || dateOrEmpty(n.deptDecisionDate))
        // Off-campus / online offenses: SAEP reviews whether a ground for jurisdiction applies. Declining closes the case.
        && (!('jurisdictionReview' in n) || n.jurisdictionReview in ['', 'confirmed', 'declined'])
        && (!('jurisdictionReview' in n) || n.jurisdictionReview == '' || n.get('venue', 'campus') == 'offcampus')
        && (!('jurisdictionReview' in n) || n.jurisdictionReview != 'declined' || n.status == 'resolved');
    }

    // "Others": no catalog entry and no category. SAEP classifies it later, so the complainant must describe it.
    function othersOk(d) {
      return d.offenseId == 'others' && d.type == 'Others (not listed)' && d.offense == 'Unclassified'
        && 'offenseOther' in d && d.offenseOther is string && d.offenseOther.size() >= 3 && d.offenseOther.size() <= 100;
    }

    function profileOk(n, role) {
      return n.name is string && n.name.size() >= 2 && n.name.size() <= 120
        && (!('sid' in n) || (n.sid is string && (role == 'student' ? n.sid.matches('^[0-9]{7}$') : n.sid.size() <= 20)))
        && (!('course' in n) || (n.course is string && n.course.size() <= 60))
        && (!('section' in n) || (n.section is string && n.section.size() <= 20))
        && (!('dept' in n) || (n.dept is string && n.dept.size() <= 80))
        && (!('position' in n) || (n.position is string && n.position.size() <= 80))
        && (!('contact' in n) || (n.contact is string && n.contact.matches('^[0-9+() -]{7,20}$')))
        && n.profileAt == request.time;
    }

    function validNew(d) {
      return d.keys().hasOnly(['student','sid','program','rDept','rEmail','rContact','cSid','cCourse','cDept','cContact','signature','signatureImg','route','offenseId','offense','offenseOther','type','date','location','venue','jurisdiction','desc','filed','status','filedBy','filedByName','filedByRole','filedByEmail','privacyConsent','privacyVersion','hCount','files','createdAt'])
        && d.student is string && d.student.size() >= 2 && d.student.size() <= 120
        && d.sid is string && d.sid.matches('^[0-9]{7}$')
        && d.program is string && d.program.size() >= 1 && d.program.size() <= 60
        && d.rDept is string && d.rDept.size() >= 1 && d.rDept.size() <= 80
        && d.rEmail is string && d.rEmail.size() <= 120 && (d.rEmail == '' || d.rEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && d.rContact is string && (d.rContact == '' || d.rContact.matches('^[0-9+() -]{7,20}$'))
        && d.cSid is string && (d.filedByRole == 'student' ? d.cSid.matches('^[0-9]{7}$') : d.cSid.size() <= 20)
        && d.cCourse is string && d.cCourse.size() <= 60 && (d.filedByRole != 'student' || d.cCourse.size() >= 1)
        && d.cDept is string && d.cDept.size() >= 1 && d.cDept.size() <= 80
        && d.cContact is string && d.cContact.matches('^[0-9+() -]{7,20}$')
        // The complainant block must be exactly the saved profile (so the form can't be filed with made-up or outdated details).
        && d.cSid == userDoc().get('sid', '') && d.cCourse == userDoc().get('course', '')
        && d.cDept == userDoc().get('dept', '') && d.cContact == userDoc().get('contact', '')
        && d.signature is string && d.signature.size() >= 2 && d.signature.size() <= 120
        && d.signatureImg is string && d.signatureImg.size() <= 200000 && d.signatureImg.matches('^data:image/(png|jpeg);base64,.*')
        && d.offense in ['First Degree', 'Second Degree', 'Third Degree', 'Unclassified']
        && d.type is string && d.type.size() >= 2 && d.type.size() <= 80
        && (othersOk(d) || (!('offenseOther' in d) && offenseOk(d)))
        && isDate(d.date) && d.filed == phToday() && d.date <= d.filed
        && d.location is string && d.location.size() >= 1 && d.location.size() <= 200
        // Where it happened. Off-campus or online offenses need at least one ground for the University's jurisdiction
        // (policy, Off-Campus and Online Offenses); on-campus ones carry none.
        && d.get('venue', 'campus') in ['campus', 'offcampus']
        && d.get('jurisdiction', []) is list && d.get('jurisdiction', []).size() <= 5
        && d.get('jurisdiction', []).hasOnly(['victim', 'event', 'status', 'objectives', 'name'])
        && (d.get('venue', 'campus') == 'offcampus' ? d.get('jurisdiction', []).size() >= 1 : d.get('jurisdiction', []).size() == 0)
        && d.desc is string && d.desc.size() >= 30 && d.desc.size() <= 5000
        && d.route == (d.offense == 'First Degree' ? 'department' : 'cdb')
        && d.status == 'submitted'
        && d.filedBy == request.auth.uid
        && d.filedByName is string && d.filedByName.size() <= 120 && d.filedByName == userDoc().name
        && d.filedByRole in ['student', 'faculty'] && d.filedByRole == userDoc().role
        && d.filedByEmail == request.auth.token.email
        && d.privacyConsent == true
        && d.privacyVersion is string && d.privacyVersion.size() <= 20
        && d.hCount == 0
        && d.files is list && d.files.size() == 0
        && d.createdAt == request.time;
    }

    match /users/{uid} {
      allow read: if domainOk() && (request.auth.uid == uid || isStaff());
      allow create: if domainOk() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role in ['student', 'faculty']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.createdAt == request.time;
      // Profile: the owner can edit their own details (never email, role or createdAt). Staff-only role changes stay in the console.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'sid', 'course', 'section', 'dept', 'position', 'contact', 'profileAt'])
        && profileOk(request.resource.data, resource.data.role);
      allow delete: if false;
    }

    // Offense catalog taken from the College Student Discipline Policy (SAEP M, Revision No. 4): the three offense lists. Everyone signed in can read it; only staff edit it.
    match /offenses/{oid} {
      allow read: if signedIn();
      allow create, update: if isStaff() && oid.matches('^[a-z0-9-]{2,60}$')
        && request.resource.data.keys().hasOnly(['type', 'category', 'sanction', 'section', 'venues'])
        && request.resource.data.type is string && request.resource.data.type.size() >= 2 && request.resource.data.type.size() <= 80
        && request.resource.data.category in ['First Degree', 'Second Degree', 'Third Degree']
        && request.resource.data.sanction is string && request.resource.data.sanction.size() <= 1000
        && request.resource.data.section is string && request.resource.data.section.size() <= 60
        && (!('venues' in request.resource.data) || (request.resource.data.venues is list && request.resource.data.venues.size() >= 1 && request.resource.data.venues.hasOnly(['campus', 'offcampus'])));
      allow delete: if isStaff();
    }

    match /complaints/{id} {
      allow read: if signedIn() && (resource.data.filedBy == request.auth.uid || isStaff());
      // The case number must be exactly the counter value written in the same transaction.
      allow create: if signedIn() && validNew(request.resource.data)
        && id.matches('^SAEP-[0-9]{4}-[0-9]{3,}$')
        && id.split('-')[1] == phToday().split('-')[0]
        && id == caseId(id.split('-')[1], getAfter(/databases/$(db)/documents/counters/$(id.split('-')[1])).data.n);

      // Staff change status / hearing date / resolution note. Every change must come with a history entry
      // (history/{hCount}) written in the same batch, and hCount goes up by exactly one.
      function staffEdit() {
        let n = request.resource.data;
        return isStaff()
          && n.diff(resource.data).affectedKeys().hasOnly(['status', 'hearingDate', 'resolution', 'updatedAt', 'updatedBy', 'hCount', 'route', 'noticeDate', 'answerDue', 'answer', 'parentsNotified', 'conferenceMode', 'conferencesHeld', 'decisionDate', 'interventions', 'appeal', 'appealDate', 'assessedDegree', 'deptDecisionDate', 'jurisdictionReview'])
          && n.status in ['submitted', 'review', 'hearing', 'resolved']
          && n.updatedAt == request.time && n.updatedBy == request.auth.uid
          && n.hCount == resource.data.get('hCount', 0) + 1
          && existsAfter(/databases/$(db)/documents/complaints/$(id)/history/$(string(n.hCount)))
          && n.hearingDate is string && (n.hearingDate == '' || isDate(n.hearingDate))
          && (n.status != 'hearing' || n.hearingDate != '')
          && n.resolution is string && n.resolution.size() <= 2000
          && (n.status != 'resolved' || n.resolution.size() >= 5)
          && processOk(n, resource.data);
      }
      // Each evidence entry is {name, path} and the path must point into the filer's own folder for this case.
      function fileOk(f) {
        return f is map && f.keys().hasOnly(['name', 'path'])
          && f.name is string && f.name.size() > 0 && f.name.size() <= 120
          && f.path is string && f.path.matches('^evidence/' + request.auth.uid + '/' + id + '/[^/]+$');
      }
      function filesOk(l) {
        return l is list && l.size() <= 5
          && (l.size() < 1 || fileOk(l[0])) && (l.size() < 2 || fileOk(l[1])) && (l.size() < 3 || fileOk(l[2]))
          && (l.size() < 4 || fileOk(l[3])) && (l.size() < 5 || fileOk(l[4]));
      }
      // The filer can attach evidence (max 5) while the case is still 'submitted'.
      function filerAttach() {
        return resource.data.filedBy == request.auth.uid && resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files'])
          && filesOk(request.resource.data.files);
      }
      allow update: if signedIn() && (staffEdit() || filerAttach());
      allow delete: if false;

      // Append-only status history that the filer can read: from, to, remark, when. It deliberately holds NO staff
      // identity; that lives in the staff-only audit entry with the same id, written in the same batch.
      match /history/{hid} {
        allow read: if signedIn() && (get(/databases/$(db)/documents/complaints/$(id)).data.filedBy == request.auth.uid || isStaff());
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['from', 'to', 'remark', 'at'])
          && request.resource.data.from == get(/databases/$(db)/documents/complaints/$(id)).data.status
          && request.resource.data.to == getAfter(/databases/$(db)/documents/complaints/$(id)).data.status
          && hid == string(getAfter(/databases/$(db)/documents/complaints/$(id)).data.hCount)
          && request.resource.data.remark is string && request.resource.data.remark.size() <= 500
          && (rank(request.resource.data.to) >= rank(request.resource.data.from) || request.resource.data.remark.size() >= 5)
          && request.resource.data.at == request.time
          && existsAfter(/databases/$(db)/documents/complaints/$(id)/audit/$(hid));
        allow update, delete: if false;
      }

      // Staff-only record of WHO made each change (same id as the history entry). Append-only.
      match /audit/{hid} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 120
          && hid == string(getAfter(/databases/$(db)/documents/complaints/$(id)).data.hCount)
          && request.resource.data.at == request.time
          && existsAfter(/databases/$(db)/documents/complaints/$(id)/history/$(hid));
        allow update, delete: if false;
      }

      // Record of emails that SAEP staff sent about a case (UBridge never sends mail itself; staff send from their own
      // email app and confirm it). Append-only and staff only: the respondent's address and the message text are kept here.
      match /emails/{eid} {
        allow read: if isStaff();
        allow create: if isStaff()
          && exists(/databases/$(db)/documents/complaints/$(id))
          && request.resource.data.keys().hasOnly(['kind', 'to', 'cc', 'subject', 'body', 'by', 'byName', 'at'])
          && request.resource.data.kind in ['notice', 'followup', 'schedule', 'decision', 'department']
          && request.resource.data.to is string && request.resource.data.to.size() >= 5 && request.resource.data.to.size() <= 300
          && request.resource.data.cc is string && request.resource.data.cc.size() <= 300
          && request.resource.data.subject is string && request.resource.data.subject.size() >= 1 && request.resource.data.subject.size() <= 200
          && request.resource.data.body is string && request.resource.data.body.size() >= 20 && request.resource.data.body.size() <= 5000
          && request.resource.data.by == request.auth.uid
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 120
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Evidence kept in Firestore while Cloud Storage is off (free plan). Items 1 to 5, written once by the filer
      // while the case is still 'submitted'; the filer and staff can read them.
      match /evidence/{eid} {
        allow read: if signedIn() && (get(/databases/$(db)/documents/complaints/$(id)).data.filedBy == request.auth.uid || isStaff());
        allow create: if signedIn() && eid.matches('^[1-5]$')
          && get(/databases/$(db)/documents/complaints/$(id)).data.filedBy == request.auth.uid
          && get(/databases/$(db)/documents/complaints/$(id)).data.status == 'submitted'
          && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'data', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.type in ['image/jpeg', 'image/png', 'application/pdf']
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 716800
          && request.resource.data.data is string && request.resource.data.data.size() <= 980000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // In-app notifications (free-plan substitute for email). Staff write one for the filer when a case changes;
    // the recipient can read their own and mark them read.
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['uid', 'caseId', 'message', 'read', 'createdAt'])
        && request.resource.data.caseId is string && request.resource.data.caseId.matches('^SAEP-[0-9]{4}-[0-9]{3,}$')
        && request.resource.data.uid == get(/databases/$(db)/documents/complaints/$(request.resource.data.caseId)).data.filedBy
        && request.resource.data.message is string && request.resource.data.message.size() <= 200
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    // Yearly case-number counter: +1 only, and only together with the complaint that uses that number.
    match /counters/{year} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1
        && existsAfter(/databases/$(db)/documents/complaints/$(caseId(year, 1)));
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && existsAfter(/databases/$(db)/documents/complaints/$(caseId(year, request.resource.data.n)));
    }
  }
}
